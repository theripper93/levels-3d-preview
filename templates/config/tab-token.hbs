<section class='tab {{tab.cssClass}}' data-group='primary' data-tab='token'>

  <div class="form-group">
    <label>{{localize "levels3dpreview.settings.flatTokenStyle.name"}}</label>
    <select name="flatTokenStyle" data-dtype="String">
      <option {{#if (eq flatTokenStyle "flat")}}selected{{/if}} value="flat">{{localize "levels3dpreview.settings.flatTokenStyle.options.flat"}}</option>
      <option {{#if (eq flatTokenStyle "extruded")}}selected{{/if}} value="extruded">{{localize "levels3dpreview.settings.flatTokenStyle.options.extruded"}}</option>
      <option {{#if (eq flatTokenStyle "coin")}}selected{{/if}} value="coin">{{localize "levels3dpreview.settings.flatTokenStyle.options.coin"}}</option>
    </select>
    <p class="hint">{{localize "levels3dpreview.settings.flatTokenStyle.hint"}}</p>
  </div>

  <div class="form-group">
    <label>{{localize "levels3dpreview.settings.highlightCombat.name"}}</label>
    <input type="checkbox" name="highlightCombat" data-dtype="Boolean" {{checked highlightCombat}} />
    <p class="hint">{{localize "levels3dpreview.settings.highlightCombat.hint"}}</p>
  </div>

  <div class="form-group">
    <label>{{localize "levels3dpreview.settings.startMarker.name"}}</label>
    <input type="checkbox" name="startMarker" data-dtype="Boolean" {{checked startMarker}} />
    <p class="hint">{{localize "levels3dpreview.settings.startMarker.hint"}}</p>
  </div>

  <div class="form-group">
    <label>{{localize "levels3dpreview.settings.tokenVisibility.name"}}</label>
    <select name="tokenVisibility" data-dtype="String">
      <option {{#if (eq tokenVisibility "off")}}selected{{/if}} value="off">{{localize "levels3dpreview.settings.tokenVisibility.options.off"}}</option>
      <option {{#if (eq tokenVisibility "standard")}}selected{{/if}} value="standard">{{localize "levels3dpreview.settings.tokenVisibility.options.standard"}}</option>
      <option {{#if (eq tokenVisibility "dynamic")}}selected{{/if}} value="dynamic">{{localize "levels3dpreview.settings.tokenVisibility.options.dynamic"}}</option>
    </select>
    <p class="hint">{{localize "levels3dpreview.settings.tokenVisibility.hint"}}</p>
  </div>

</section>