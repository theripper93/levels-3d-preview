
<section class='tab {{tab.cssClass}}' data-group='primary' data-tab='base'>

  <div class="form-group">
    <label>{{localize "levels3dpreview.settings.baseStyle.name"}}</label>
    <select name="baseStyle" data-dtype="String">
      {{#each CONFIG.tokenBase}}
        <option {{#if (eq id ../baseStyle)}}selected{{/if}} value="{{id}}">{{name}}</option>
      {{/each}}
    </select>
    <p class="hint">{{localize "levels3dpreview.settings.baseStyle.hint"}}</p>
  </div>

  <div class="form-group">
    <label>{{localize "levels3dpreview.settings.solidBaseColor.name"}}</label>
    <div class="form-fields">
      <input class="color" type="text" name="solidBaseColor" value="{{solidBaseColor}}">
      <input type="color" data-edit="solidBaseColor" value="{{solidBaseColor}}">
    </div>
    <p class="hint">{{localize "levels3dpreview.settings.solidBaseColor.hint"}}</p>
  </div>

  <div class="form-group">
    <label>{{localize "levels3dpreview.settings.removeModelBase.name"}}</label>
    <input type="checkbox" name="removeModelBase" data-dtype="Boolean" {{checked removeModelBase}} />
    <p class="hint">{{localize "levels3dpreview.settings.removeModelBase.hint"}}</p>
  </div>

</section>