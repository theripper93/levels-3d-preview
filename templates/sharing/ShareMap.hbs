<div>
    <fieldset>
        <div class="form-group">
            <label>{{localize "levels3dpreview.sharing.sharemap.author"}}</label>
            <div class="form-fields">
                <input type="text" name="author" value="{{author}}">
            </div>
        </div>
        <div class="form-group">
            <label>{{localize "levels3dpreview.sharing.sharemap.secret"}}</label>
            <div class="form-fields">
                <input type="text" name="secret" value="{{secret}}">
            </div>
            <p class="hint">{{localize "levels3dpreview.sharing.sharemap.secretinfo"}}</p>
        </div>
        <div class="form-group stacked">
            <label>{{localize "levels3dpreview.sharing.sharemap.description"}}</label>
            <textarea name="description" rows="3"></textarea>
        </div>
    </fieldset>
    <fieldset>
        <legend>{{localize "levels3dpreview.sharing.sharemap.assetpacks"}}</legend>
        <div class="form-group">
            <multi-checkbox name="assetpacks">
                {{selectOptions assetpacks selected=selectedPacks localize=true}}
            </multi-checkbox>
            <p class="hint">{{localize "levels3dpreview.sharing.sharemap.assetinfo"}}</p>
        </div>
        <div class="form-group">
            <label>{{localize "levels3dpreview.sharing.sharemap.mapMaker"}}</label>
            <div class="form-fields">
                <input type="checkbox" name="mapMaker" {{checked mapMaker}}>
            </div>
        </div>
    </fieldset>
    <fieldset>
        <legend>{{localize "levels3dpreview.sharing.sharemap.image"}}</legend>
        <div class="form-group">
            <div class="form-fields">
                <input type="text" name="image" placeholder="{{localize "levels3dpreview.sharing.sharemap.imageplaceholder"}}">
                <button type="button" class="tdc-share-capture" data-action="capture" data-tooltip="{{captureTooltip}}" {{disabled captureDisabled}}>
                    <i class="fa-solid fa-camera"></i> {{localize "levels3dpreview.sharing.sharemap.capture"}}
                </button>
            </div>
        </div>
        <figure class="tdc-share-preview {{#unless image}}empty{{/unless}}">
            <img {{#if image}}src="{{image}}"{{/if}} alt="">
            <i class="fa-solid fa-image"></i>
        </figure>
    </fieldset>
    <p class="hint">{{localize "levels3dpreview.sharing.sharemap.agreement"}}</p>
</div>
