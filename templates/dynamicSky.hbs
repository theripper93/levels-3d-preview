{{#*inline "styleGroups"}}
{{#each groups}}
<optgroup label="{{localize label}}" {{#if disabled}}disabled{{/if}}>
    {{#each choices}}
    <option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>
    {{/each}}
</optgroup>
{{/each}}
{{/inline}}
<div>
    <div class="form-group">
        <label>{{localize "levels3dpreview.dynamicSkyConfig.enabled.label"}}</label>
        <div class="form-fields">
            <input type="checkbox" name="flags.levels-3d-preview.dynamicSky.enabled" {{checked enabled}}>
        </div>
        <p class="hint">{{localize "levels3dpreview.dynamicSkyConfig.enabled.notes"}}</p>
    </div>

    <div class="form-group">
        <label>{{localize "levels3dpreview.dynamicSkyConfig.setting.label"}}</label>
        <div class="form-fields">
            <select name="flags.levels-3d-preview.dynamicSky.setting">
                {{selectOptions settings selected=setting localize=true}}
            </select>
        </div>
        <p class="hint">{{localize "levels3dpreview.dynamicSkyConfig.setting.notes"}}</p>
    </div>

    <div class="form-group" data-indoor-only>
        <label>{{localize "levels3dpreview.dynamicSkyConfig.style.label"}}</label>
        <div class="form-fields">
            <select name="flags.levels-3d-preview.dynamicSky.undergroundStyle">
                {{> styleGroups groups=undergroundStyles}}
            </select>
        </div>
        <p class="hint">{{localize "levels3dpreview.dynamicSkyConfig.undergroundStyle.notes"}}</p>
    </div>

    <div class="form-group" data-indoor-only data-style-fields="">
        <label>{{localize "levels3dpreview.dynamicSkyConfig.backgroundColor.label"}}</label>
        <div class="form-fields">
            <color-picker name="flags.levels-3d-preview.dynamicSky.backgroundColor" value="{{backgroundColor}}"></color-picker>
        </div>
        <p class="hint">{{localize "levels3dpreview.dynamicSkyConfig.backgroundColor.notes"}}</p>
    </div>

    <div class="form-group" data-outdoor-only>
        <label>{{localize "levels3dpreview.dynamicSkyConfig.style.label"}}</label>
        <div class="form-fields">
            <select name="flags.levels-3d-preview.dynamicSky.style">
                {{> styleGroups groups=outdoorStyles}}
            </select>
        </div>
        <p class="hint">{{localize "levels3dpreview.dynamicSkyConfig.style.notes"}}</p>
    </div>

    <div class="form-group" data-outdoor-only data-sky-option="preset">
        <label>{{localize "levels3dpreview.dynamicSkyConfig.preset.label"}}</label>
        <div class="form-fields">
            <select name="flags.levels-3d-preview.dynamicSky.preset">
                {{selectOptions presets selected=preset localize=true}}
            </select>
        </div>
        <p class="hint">{{localize "levels3dpreview.dynamicSkyConfig.preset.notes"}}</p>
    </div>

    <div class="form-group" data-timed data-sky-option="time">
        <label>{{localize "levels3dpreview.dynamicSkyConfig.time.label"}}</label>
        <div class="form-fields">
            <range-picker name="flags.levels-3d-preview.sunPosition" value="{{time}}" min=0 max=24 step=0.1></range-picker>
        </div>
        <p class="hint">{{localize "levels3dpreview.dynamicSkyConfig.time.notes"}}</p>
    </div>

    <fieldset data-outdoor-only data-sky-option="tint sun stars moon">
        <legend>{{localize "levels3dpreview.dynamicSkyConfig.sky"}}</legend>

        <div class="form-group" data-sky-option="tint">
            <label>{{localize "levels3dpreview.dynamicSkyConfig.color.label"}}</label>
            <div class="form-fields">
                <color-picker name="flags.levels-3d-preview.dynamicSky.color" value="{{color}}"></color-picker>
            </div>
            <p class="hint">{{localize "levels3dpreview.dynamicSkyConfig.color.notes"}}</p>
        </div>

        <div class="form-group" data-custom-only data-sky-option="sun">
            <label>{{localize "levels3dpreview.dynamicSkyConfig.haze.label"}}</label>
            <div class="form-fields">
                <range-picker name="flags.levels-3d-preview.dynamicSky.turbidity" value="{{turbidity}}" min=2 max=20 step=0.1></range-picker>
            </div>
        </div>

        <div class="form-group" data-custom-only data-sky-option="sun">
            <label>{{localize "levels3dpreview.dynamicSkyConfig.sunGlow.label"}}</label>
            <div class="form-fields">
                <range-picker name="flags.levels-3d-preview.dynamicSky.mieDirectionalG" value="{{mieDirectionalG}}" min=0.7 max=0.999 step=0.001></range-picker>
            </div>
        </div>

        <div class="form-group" data-custom-only data-sky-option="stars">
            <label>{{localize "levels3dpreview.dynamicSkyConfig.starDensity.label"}}</label>
            <div class="form-fields">
                <range-picker name="flags.levels-3d-preview.dynamicSky.starDensity" value="{{starDensity}}" min=0.1 max=2 step=0.1></range-picker>
            </div>
        </div>

        <div class="form-group" data-sky-option="moon">
            <label>{{localize "levels3dpreview.dynamicSkyConfig.moonPhase.label"}}</label>
            <div class="form-fields">
                <select name="flags.levels-3d-preview.dynamicSky.moonPhase" data-dtype="Number">
                    {{selectOptions moonPhases selected=moonPhase localize=true}}
                </select>
            </div>
        </div>
    </fieldset>

    <fieldset data-outdoor-only data-sky-option="clouds">
        <legend>{{localize "levels3dpreview.dynamicSkyConfig.clouds"}}</legend>

        <div class="form-group">
            <label>{{localize "levels3dpreview.dynamicSkyConfig.enableClouds.label"}}</label>
            <div class="form-fields">
                <input type="checkbox" name="flags.levels-3d-preview.dynamicSky.enableClouds" {{checked enableClouds}}>
            </div>
        </div>

        <div class="form-group" data-custom-only>
            <label>{{localize "levels3dpreview.dynamicSkyConfig.cloudsCover.label"}}</label>
            <div class="form-fields">
                <range-picker name="flags.levels-3d-preview.dynamicSky.cloudsCover" value="{{cloudsCover}}" min=0 max=1 step=0.01></range-picker>
            </div>
        </div>

        <div class="form-group">
            <label>{{localize "levels3dpreview.dynamicSkyConfig.cloudsSpeed.label"}}</label>
            <div class="form-fields">
                <range-picker name="flags.levels-3d-preview.dynamicSky.cloudsSpeed" value="{{cloudsSpeed}}" min=0 max=10 step=0.1></range-picker>
            </div>
        </div>

        <div class="form-group">
            <label>{{localize "levels3dpreview.dynamicSkyConfig.cloudsScale.label"}}</label>
            <div class="form-fields">
                <range-picker name="flags.levels-3d-preview.dynamicSky.cloudsScale" value="{{cloudsScale}}" min=0.1 max=9.9 step=0.1></range-picker>
            </div>
        </div>

        <div class="form-group">
            <label>{{localize "levels3dpreview.dynamicSkyConfig.cloudsAlpha.label"}}</label>
            <div class="form-fields">
                <range-picker name="flags.levels-3d-preview.dynamicSky.cloudsAlpha" value="{{cloudsAlpha}}" min=0 max=1 step=0.05></range-picker>
            </div>
        </div>

        <div class="form-group">
            <label>{{localize "levels3dpreview.dynamicSkyConfig.cloudsTint.label"}}</label>
            <div class="form-fields">
                <color-picker name="flags.levels-3d-preview.dynamicSky.cloudsTint" value="{{cloudsTint}}"></color-picker>
            </div>
        </div>
    </fieldset>

    {{#each styleFields}}
    <fieldset data-style-fields="{{id}}">
        <legend>{{localize label}}</legend>
        {{#each fields}}
        <div class="form-group">
            <label>{{localize label}}</label>
            <div class="form-fields">
                {{#if (eq type "color")}}
                <color-picker name="{{name}}" value="{{value}}"></color-picker>
                {{else if (eq type "checkbox")}}
                <input type="checkbox" name="{{name}}" {{checked value}}>
                {{else if (eq type "select")}}
                <select name="{{name}}">
                    {{selectOptions choices selected=value localize=true}}
                </select>
                {{else}}
                <range-picker name="{{name}}" value="{{value}}" min="{{min}}" max="{{max}}" step="{{step}}"></range-picker>
                {{/if}}
            </div>
            {{#if hint}}<p class="hint">{{localize hint}}</p>{{/if}}
        </div>
        {{/each}}
    </fieldset>
    {{/each}}
</div>
